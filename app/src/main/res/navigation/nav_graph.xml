<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <!-- Dashboard -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.madhum.marga.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_analyticsFragment"
            app:destination="@id/analyticsFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_hiveListFragment"
            app:destination="@id/hiveListFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_inspectionFragment"
            app:destination="@id/inspectionFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_harvestFragment"
            app:destination="@id/harvestFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_floraCalendarFragment"
            app:destination="@id/floraCalendarFragment" />
    </fragment>

    <!-- Hive List -->
    <fragment
        android:id="@+id/hiveListFragment"
        android:name="com.madhum.marga.ui.hive.HiveListFragment"
        android:label="My Hives"
        tools:layout="@layout/fragment_hive_list">

        <action
            android:id="@+id/action_hiveListFragment_to_addEditHiveFragment"
            app:destination="@id/addEditHiveFragment" />

        <action
            android:id="@+id/action_hiveListFragment_to_inspectionFragment"
            app:destination="@id/inspectionFragment" />
    </fragment>

    <!-- Add / Edit Hive -->
    <fragment
        android:id="@+id/addEditHiveFragment"
        android:name="com.madhum.marga.ui.hive.AddEditHiveFragment"
        android:label="Add Hive"
        tools:layout="@layout/fragment_add_edit_hive">
        <argument
            android:name="hiveId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

    <!-- Inspection Log -->
    <fragment
        android:id="@+id/inspectionFragment"
        android:name="com.madhum.marga.ui.inspection.InspectionFragment"
        android:label="Inspection Log"
        tools:layout="@layout/fragment_inspection">
        <argument
            android:name="hiveId"
            app:argType="integer"
            android:defaultValue="-1" />
        <argument
            android:name="hiveName"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- Harvest -->
    <fragment
        android:id="@+id/harvestFragment"
        android:name="com.madhum.marga.ui.harvest.HarvestFragment"
        android:label="Harvest Tracker"
        tools:layout="@layout/fragment_harvest" />

    <!-- Flora Calendar -->
    <fragment
        android:id="@+id/floraCalendarFragment"
        android:name="com.madhum.marga.ui.flora.FloraCalendarFragment"
        android:label="Flora Calendar"
        tools:layout="@layout/fragment_flora_calendar" />

    <!-- Analytics -->
    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.madhum.marga.ui.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

</navigation>
