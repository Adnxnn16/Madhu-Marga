<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_card"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Color dot -->
        <View
            android:id="@+id/viewColorDot"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_circle"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFlowerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mustard"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvLocalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sarson"
                android:textSize="14sp"
                android:textColor="@color/honey_primary_dark"
                android:fontFamily="sans-serif-italic" />

            <TextView
                android:id="@+id/tvRegion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_hint" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvYield"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:background="@drawable/bg_yield_chip" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
